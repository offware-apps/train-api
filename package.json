{
  "name": "train-api",
  "version": "0.1.0",
  "private": true,
  "description": "Open train data for rail passes (Interrail first), served as static JSON, with a journey search that runs in the browser or as a self-hosted API.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch": "tsx scripts/fetch.ts",
    "build:api": "tsx scripts/build-api.ts",
    "search": "tsx scripts/search.ts",
    "start": "tsx src/server.ts",
    "probe:europe": "tsx scripts/probe-europe.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
